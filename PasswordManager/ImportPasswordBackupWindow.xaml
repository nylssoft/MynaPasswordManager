<Window x:Class="PasswordManager.ImportPasswordBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:PasswordManager.Properties"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        Width="600" SizeToContent="Height" Icon="Images/logo.png" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10,10,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="{x:Static props:Resources.LABEL_IMPORT_BACKUP_PASSPHRASE}" />
        <Label Grid.Row="1" Grid.Column="0" Content="{x:Static props:Resources.LABEL_PASSWORD}" Target="{Binding ElementName=passwordBox}" />
        <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="passwordBox" MaxLength="1024" Height="23" PasswordChanged="PasswordBox_PasswordChanged" />
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="buttonOK" IsDefault="True" Content="{x:Static props:Resources.BUTTON_OK}" Height="23" Width="80" Margin="5,0,5,0" Click="ButtonOK_Click" IsEnabled="False" />
            <Button Content="{x:Static props:Resources.BUTTON_CANCEL}" IsCancel="True" Height="23" Width="80" Margin="5,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
